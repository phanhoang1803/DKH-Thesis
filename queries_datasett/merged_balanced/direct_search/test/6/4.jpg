table\":\"Answer\",\"numUpvotes\":1,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":10527979,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"2\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjM=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"relatedQuestions\":[{\"id\":\"UXVlc3Rpb25AMDoxNTY4NTM2MzQ=\",\"__typename\":\"Question\",\"qid\":156853634,\"url\":\"https://ondiplomacywarfare.quora.com/What-are-some-factors-that-can-indicate-whether-a-war-is-going-to-start-or-end\",\"slug\":\"What-are-some-factors-that-can-indicate-whether-a-war-is-going-to-start-or-end-1\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"What are some factors that can indicate whether a war is going to start or end?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjExNzI1NzIyODg=\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":1172572288},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":{\"__typename\":\"QuestionTribeItem\",\"tribe\":{\"id\":\"VHJpYmVAMDoxNzQwODA2\"},\"id\":\"UXVlc3Rpb25UcmliZUl0ZW1AMDoxMDU1Mzg5NzE=\"}},{\"id\":\"UXVlc3Rpb25AMDo2NTQyODA4Mg==\",\"__typename\":\"Question\",\"qid\":65428082,\"url\":\"/Is-The-Art-of-War-helpful-in-life-business-or-only-war\",\"slug\":\"Is-The-Art-of-War-helpful-in-life-business-or-only-war\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Is The Art of War helpful in life/business or only war?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjQyMDkzNzAyMQ==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":420937021},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDo2NjU4MzQx\",\"__typename\":\"Question\",\"qid\":6658341,\"url\":\"/When-is-war-a-good-solution-to-a-major-problem\",\"slug\":\"When-is-war-a-good-solution-to-a-major-problem\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When is war a good solution to a major problem?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjI1ODU0\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":25854},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDoxNjAzOTU1OQ==\",\"__typename\":\"Question\",\"qid\":16039559,\"url\":\"/Does-the-world-have-too-many-large-towns-and-cities\",\"slug\":\"Does-the-world-have-too-many-large-towns-and-cities\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Does the world have too many large towns and cities?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjI3ODQ3MjA0\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":27847204},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDoyMDI5MDUzMw==\",\"__typename\":\"Question\",\"qid\":20290533,\"url\":\"/How-is-it-possible-to-motivate-a-modern-nation\\u2019s-population-to-support-an-offensive-war-not-based-on-religious-grounds\",\"slug\":\"How-is-it-possible-to-motivate-a-modern-nation\\u2019s-population-to-support-an-offensive-war-not-based-on-religious-grounds\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How is it possible to motivate a modern nation\\\\u2019s population to support an offensive war not based on religious grounds?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjMxNDYyNTEzOQ==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":314625139},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null}],\"id\":\"UXVlc3Rpb25JbmxpbmVSZWxhdGVkUXVlc3Rpb25zSXRlbUAwOjM1MDc4MDk6aW5saW5lX2xpbmtzOjE=\",\"__typename\":\"QuestionInlineRelatedQuestionsItem\",\"__isQuestionPagedListItem\":\"QuestionInlineRelatedQuestionsItem\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"__typename\":\"Question\"},\"hashSuffix\":\"-1772240406\"},\"cursor\":\"3\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjQ=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25BbnN3ZXJJdGVtMkAwOjM1MDc4MDk6YW5zd2VyOjEwNTM1NTIy\",\"__typename\":\"QuestionAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\"},\"index\":1,\"answer\":{\"id\":\"QW5zd2VyQDA6MTA1MzU1MjI=\",\"aid\":10535522,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"I'd offer the example of Sarajevo, in Bosnia. I was stationed in Bosnia in 2004-5, ten years after the shooting war ended. There was still shooting...quite a bit of it. Organized crime were rampant, and other things were happening that were far from peaceful and still involved people getting hurt and killed. Corruption was everywhere. Land mines, unexploded ordnance (UXO) and areas contaminated by depleted uranium ammunition used during the fighting were scattered around and, in some cases, in the city. Many buildings were still damaged and some where uninhabitable. What made it particularly weird is that there was a city doing its thing all around this, with shops, restaurants and a vigorous night-life. But it was far from \\\\\\\"normal\\\\\\\" in any sense.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Now, another ten years on, there have been some improvements, but there are still lots of issues and problems. Land mines and UXO are still a huge problem, as is crime and corruption. Various trans-national actors are still meddling in things. Worst of all, the ethnic, social, cultural and religious tensions that fueled the war are still there. Progress is happening, but it's VERY slow.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"As a kid, I visited London, England, in the early 70s...there were still bomb-damaged buildings from WW2 that had yet to be torn down. So it can definitely take a lot of time. The bigger problem is, though, that rebuilding the physical infrastructure is easy. Dealing with the social, economic, cultural and other issues that arise during armed conflict is much, much harder to address, especially if the fighting was the result of internal factors to the country.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|2023442300\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-10535522_92702ec62dfe93f16eaff635e203d2d2\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"isDeleted\":false,\"url\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjU5NDMwNDQ=\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":5943044},\"slug\":\"When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":2,\"suggestedReplies\":[]},\"permaUrl\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc/answer/David-Laderoute\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc/answer/David-Laderoute\",\"viewerCanRestoreAnswer\":false,\"originalQuestionIfDifferent\":null,\"__isMonetizable\":\"Answer\",\"oid\":10535522,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjcxNjg4Njgy\",\"uid\":71688682,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6NzE2ODg2ODI6TEFUTg==\",\"reverseOrder\":false,\"givenName\":\"David\",\"familyName\":\"Laderoute\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/David-Laderoute\",\"smallProfileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"profileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"enabled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1426433827598167,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TGlmZUV4cGVyaWVuY2VDcmVkZW50aWFsQDA6MzM4OTgzMDM=\",\"__typename\":\"LifeExperienceCredential\",\"__isCredential\":\"LifeExperienceCredential\",\"translatedString\":\"Retired Lieutenant Colonel, Canadian Army (Infantry)\",\"experience\":{\"id\":\"VG9waWNAMDo2Mjk2\",\"__typename\":\"Topic\",\"tid\":6296,\"name\":\"Military\"},\"description\":\"Retired Lieutenant Colonel, Canadian Army (Infantry)\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":33898303},\"isTranslated\":false,\"url\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc/answer/David-Laderoute\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoxMDUzNTUyMjpbMTQxNiwgMjAyNjIwMF0=\",\"viewCount\":2026200,\"answerCount\":1416}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"smart_distribution\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":393,\"__isVotable\":\"Answer\",\"numUpvotes\":5,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":10535522,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"4\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjU=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6NDQ0MzI4ODM=\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":2,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\"},\"answer\":{\"originalQuestionIfDifferent\":{\"question\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\",\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers? Would they clear the buildings one by one?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE5ODYyOTM1Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":198629357},\"slug\":\"How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"debugInfo\":\"{}\",\"viewer\":{\"user\":null,\"id\":\"Vmlld2VyQDA6MA==\"}},\"id\":\"T3JpZ2luYWxseUFuc3dlcmVkUXVlc3Rpb25AMDo0NDQzMjg4MzoxNTE3NDI4Mg==\",\"originalQuestionText\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionBannerRemoved\":false},\"id\":\"QW5zd2VyQDA6NDQ0MzI4ODM=\",\"aid\":44432883,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"The main problem for an attacking force in a megacity is the large surface they have to deal with:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"A skyscraper takes up the same surface area as a small field, but each floor adds another small field area to the overall surface: a one hundred story building has one hundred and one times more area than just the ground (100 floors, plus the roof).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"A good example is the International Commerce Centre in Hong Kong, which has one hundred and eight floors and a supersurface of almost 300,000 square meters. This is the size of an area of operations for three infantry brigades!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"And we haven\\\\u2019t talked about the underground surfaces, yet: multi floored subterranean parking spaces and a network of subway lines and stations add many more hectares to our megacity battlefield.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In urban warfare, the defenders always have a big advantage. Often, an army that is too weak to oppose its adversary on the open ground, moves to a city to avoid annihilation. In a megacity, this \\\\u201cdefender\\\\u2019s advantage\\\\u201d will become even bigger.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Artillery, air power and armored vehicles are much less effective in an urban area than in other battlefields. Urban warfare is mainly fought with assault rifles, multiple grenade launchers, RPGs, hand grenades and, of course, sniper rifles.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\", \\\"modifiers\\\": {\\\"image\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-41867a8bb3e20e23833a998c5c8564a4-lq\\\", \\\"height\\\": 2000, \\\"width\\\": 3000, \\\"master_url\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-5b3af468478c99b03f21c5727bdbeccc-c\\\", \\\"is_deleted\\\": false, \\\"is_sensitive\\\": false, \\\"is_uploaded_by_bot\\\": false, \\\"zoomable\\\": true, \\\"dominant_color\\\": \\\"#82a7d3\\\"}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"image\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"West Beirut, 1983: the Lebanese civil war raged for more than fifteen years and a lot of the fighting happened in Beirut\\\", \\\"modifiers\\\": {\\\"italic\\\": true}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The bigger the city, the better for the defender: more places to hide and more resources.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"An attacker, on the other hand, can\\\\u2019t use many of their modern weapons as effectively as they would do on open battleground. Every single street, building, floor and room has to be cleared-a nightmare for every military commander!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The urban terrain is often unwieldy and, unlike nature, can even transform itself: structures get destroyed and make streets impassable or the ruins of a multi story building become perfect defense positions.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The attacker is also confronted with numerous specific threats: mines and boobytraps, snipers, ambushes and guerrilla style attacks are common occurrences in urban warfare.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Another important element in megacity warfare is the population. Even if an evacuation had been ordered, there will still be many thousands of people left, interfering with military operations.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Because of all this, an attacker would normally not choose a megacity as their preferred battleground. However, from Troy to Stalingrad and from Beirut to Aleppo, many battles have been fought in cities and often the fate of the whole war had been connected with the outcome of one urban battle.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"As more and more people on earth are going to live in megacities, it\\\\u2019s just a matter of time until a battle will be fought in one of them. Due to the sheer size of these cities, such a battle would become a war inside a war.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|913033414\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-44432883_585b220369f12aead99ab7da058a1df8\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\",\"isDeleted\":false,\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers? Would they clear the buildings one by one?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE5ODYyOTM1Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":198629357},\"slug\":\"How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":39,\"suggestedReplies\":[]},\"permaUrl\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Roland-Bartetzko\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Roland-Bartetzko\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":44432883,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjY5ODA1ODkw\",\"uid\":69805890,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6Njk4MDU4OTA6TEFUTg==\",\"reverseOrder\":false,\"givenName\":\"Roland\",\"familyName\":\"Bartetzko\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Roland-Bartetzko\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-69805890-50-uohrpkxwreogwlvkqfqnpeliiotpefjq.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-69805890-200-uohrpkxwreogwlvkqfqnpeliiotpefjq.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1494774557393364,\"hasSuicideTopics\":false,\"updatedTime\":1585381931788756,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TGlmZUV4cGVyaWVuY2VDcmVkZW50aWFsQDA6MzM0NDM0MjE=\",\"__typename\":\"LifeExperienceCredential\",\"__isCredential\":\"LifeExperienceCredential\",\"translatedString\":\"former German Army, Croatian Defense Council, Kosovo Liberation Army\",\"experience\":{\"id\":\"VG9waWNAMDoyNDQ5\",\"__typename\":\"Topic\",\"tid\":2449,\"name\":\"Military History and Wars \"},\"description\":\"former German Army, Croatian Defense Council, Kosovo Liberation Army\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":33443421},\"isTranslated\":false,\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Roland-Bartetzko\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDo0NDQzMjg4MzpbNDc3MSwgNDkwNzM3NjQxXQ==\",\"viewCount\":490737641,\"answerCount\":4771}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":257258,\"__isVotable\":\"Answer\",\"numUpvotes\":6331,\"__isQuoraShareable\":\"Answer\",\"numShares\":35,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":154,\"__isReportable\":\"Answer\",\"reportableId\":44432883,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"5\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjY=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTcxOTA2MDk5\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":3,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":58005085,\"id\":\"UXVlc3Rpb25AMDo1ODAwNTA4NQ==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTcxOTA2MDk5\",\"aid\":171906099,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"I took part in a military operation where we captured two cities during the Bosnian war.. Although there wasn\\\\u2019t that much fighting (our enemy, the Serbs, more or less ran away), when we entered them, both cities were as good as empty.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The only civilian I encountered was some old guy on a bicycle who wasn\\\\u2019t right in his head. I guess he had no idea what was going on. Our soldiers gave him some food (we had plenty) and after a few minutes, he disappeared. He probably thought that we were Serbs. There were probably some other civilians around, but they were hiding from us.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Most of the civilian population, however, had left their homes long before the first artillery shell had been fired on their city. Going to work like normal? No freaking way!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-1376723019\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-171906099_886f0d992c8a45b2042e4e5568ea0576\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":58005085,\"id\":\"UXVlc3Rpb25AMDo1ODAwNTA4NQ==\",\"isDeleted\":false,\"url\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When a city is captured in war, do people go to work like normal? How do the people pay for their food?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjIyMTAwMTE1Mw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":221001153},\"slug\":\"When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":7,\"suggestedReplies\":[]},\"permaUrl\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food/answer/Roland-Bartetzko\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food/answer/Roland-Bartetzko\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":171906099,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link