,\"author\":{\"id\":\"VXNlckAwOjIzMDM5OTEzOA==\",\"uid\":230399138,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6MjMwMzk5MTM4OkxBVE4=\",\"reverseOrder\":false,\"givenName\":\"Osmo\",\"familyName\":\"Ronkanen\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Osmo-Ronkanen-1\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-230399138-50-jlcojexciqigalczchmarkibzpgfgzga.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-230399138-200-jlcojexciqigalczchmarkibzpgfgzga.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1570214927603497,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":null,\"isTranslated\":false,\"url\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food/answer/Osmo-Ronkanen-1\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoxNzE5MjIyMzU6WzE0MjgxLCAxMzIyMzkxMF0=\",\"viewCount\":13223910,\"answerCount\":14281}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":480,\"__isVotable\":\"Answer\",\"numUpvotes\":2,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":171922235,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"25\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjI2\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTcyNTM5OTAx\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":22,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":58214410,\"id\":\"UXVlc3Rpb25AMDo1ODIxNDQxMA==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTcyNTM5OTAx\",\"aid\":172539901,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Not on balance, no. It can benefit people lucky enough to stay mostly on the periphery of the war itself. Examples include:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Sweden during the Thirty Years War, which under Gustavus II Adolphus did a masterful job of making others pay Sweden to participate in the alliance.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The United States in the first and second World Wars.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Sweden and Switzerland\\\\u2019s neutral trade during World War II.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Thailand\\\\u2019s remaining outside the conflicts of former French Indo-China from 1955 to 1975.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In general, if you can keep the fighting from spilling over onto your territory while your military and trade competitors destroy each other, and continue profitable trade with one or both sides, someone else\\\\u2019s war can benefit you.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-1735681796\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-172539901_a98b113ece7bc4af6c707f76a048613e\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":58214410,\"id\":\"UXVlc3Rpb25AMDo1ODIxNDQxMA==\",\"isDeleted\":false,\"url\":\"/Does-major-war-really-benefit-humanity-by-thinning-out-populations-and-creating-millions-of-jobs\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Does major war really benefit humanity by thinning out populations and creating millions of jobs?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"aske