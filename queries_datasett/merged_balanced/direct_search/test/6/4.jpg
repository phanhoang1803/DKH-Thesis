1f1300519a81003f630ef783a284b28c66a1b31cd38a116f4f717e1e439"] = window.ansFrontendGlobals.data.inlineQueryResults.results["ada151f1300519a81003f630ef783a284b28c66a1b31cd38a116f4f717e1e439"] || [];window.ansFrontendGlobals.data.inlineQueryResults.results["ada151f1300519a81003f630ef783a284b28c66a1b31cd38a116f4f717e1e439"].push("{\"data\":{\"question\":{\"pagedListDataConnection\":{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RDb25uZWN0aW9uQDA6MzUwNzgwOQ==\",\"__typename\":\"QuestionPagedListConnection\",\"adsData\":\"{\\\"answer_intervals\\\": [], \\\"ads\\\": []}\",\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":\"35\"},\"edges\":[{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjA=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25BZEl0ZW1AMDphZDpOb25lOjhiM2NmZGI2LTYwZTEtNDU5OC1iZThkLTFmNWU3MmE2NTI2MQ==\",\"__typename\":\"QuestionAdItem\",\"__isQuestionPagedListItem\":\"QuestionAdItem\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\"},\"adLocation\":\"top_slot_question\",\"ad\":null},\"cursor\":\"0\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjE=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25BbnN3ZXJIZWFkZXJJdGVtQDA6MzUwNzgwOTphbnN3ZXJIZWFkZXI=\",\"__typename\":\"QuestionAnswerHeaderItem\",\"__isQuestionPagedListItem\":\"QuestionAnswerHeaderItem\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"__typename\":\"Question\",\"areRelatedAnswersEnabled\":true,\"mixRankedAnswersCount\":32},\"numAnswers\":2},\"cursor\":\"1\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjI=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25BbnN3ZXJJdGVtMkAwOjM1MDc4MDk6YW5zd2VyOjEwNTI3OTc5\",\"__typename\":\"QuestionAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\"},\"index\":0,\"answer\":{\"id\":\"QW5zd2VyQDA6MTA1Mjc5Nzk=\",\"aid\":10527979,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"That is a highly interdependent answer, to say the least! The answer depends on many things, including on whether, and how much damage was caused, either to the city, its infrastructure, or both. And manmade disasters also could affect the outcome. For instance, if a damn is destoyed, and the city is flooded, this could render the city unusable for protracted periods of time. And if \\\\\\\"blitzkrieg\\\\\\\" (lightning war) methods of fighting are adopted, along with the \\\\\\\"scorched earth\\\\\\\" policy, which is meant to leave NOTHING useful behind for any potential enemy to utilize, then the destruction would be complete, leaving nothing except natural features of the landscape (such as rivers, hills, and such) from which to start rebuilding...if that is even a goal after such terrible destruction.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"If a city has seen combat, and the country that \\\\\\\"ravaged\\\\\\\" it--if that is indeed what happened--has enough resources, knowledge and manpower to help with the rebuilding, it might be only weeks, or months before the city life returns to a semblance of its old self. However, if the destruction is more extensive and severe, the rebuilding could take years.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Of course, that is all assuming that factional fighting, or \\\\\\\"in-fighting\\\\\\\" does not stymie the rebuilding efforts. Look only as far as the U.S.'s war on Iraq to see many examples of all of the above conditions which I have mentioned. But do not think only of the U.S. when you seek such examples. Dating back to some of the oldest recorded wars, anything from a total \\\\\\\"scorched earth\\\\\\\" style, to occupation have all been used with abundance in the various wars throughout history. It has often been said that man's inhumanity to man is a constant source of bewilderment and horror, and the singular human ability to hate and to wage war a wonder to thinking people everywhere.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In fact, about the only thing that has changed since the beginning of recorded history, is the swiftness and totality with which modern war may be waged. Think \\\\\\\"Hiroshima\\\\\\\" or \\\\\\\"Nagasaki\\\\\\\" for examples (although both cities were completely rebuilt, and both are now extremely wealthy, thriving metropolises). But of course, while not quite as destructive, modern explosives and pyrotechnics, utilized with a dominating air superiority, may cause almost as much damage over a longer period of time. Think \\\\\\\"London,\\\\\\\" \\\\\\\"Tokyo\\\\\\\" or \\\\\\\"Berlin\\\\\\\" for examples (all of which have also been rebuilt, and now are also extremely wealthy, thriving metropolises).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"War, as they say, is Hell. And ever shall it be, even when \\\\\\\"justified.\\\\\\\" And mind you, I am no \\\\\\\"hippie\\\\\\\" pacifist. Quite the opposite. I am a conservative person in many ways. It is just that I am a realist, and as such, I try to see the truth in whatever happens, either from the viewpoint of the \\\\\\\"good\\\\\\\" guys OR the \\\\\\\"bad\\\\\\\" guys. There is something to be learned from almost any viewpoint except, perhaps, a true psychopath's or megalomaniac's viewpoint, although it might still be argued that even there a lesson is to be learned, even if that lesson is just to learn what viewpoints should never be tolerated under any condition, by anyone. As I view it, life is for learning, while, as stated above, \\\\\\\"War is Hell,\\\\\\\" no matter on which side you are.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"From my perspective, and although I did not agree with them on much, as the hippies used to say, \\\\\\\"Make love, not war!\\\\\\\" And that should be something on which most people can agree...unless war is being made ON you, in which case you fight back if you are able, or hope that you have powerful friends. Then, the \\\\\\\"right\\\\\\\" or \\\\\\\"wrong\\\\\\\" of it may be left for history to decide. \\\\\\\"History,\\\\\\\" of course, being what the victors write. Oh, man, what a tangled web...with or without deceit!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-2100908185\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-10527979_05a36e6558eee879dd6e600d19f2b1fd\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"isDeleted\":false,\"url\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjU5NDMwNDQ=\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":5943044},\"slug\":\"When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":2,\"suggestedReplies\":[]},\"permaUrl\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc/answer/Shawn-H-Hall\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/When-war-affects-a-modern-city-how-long-does-it-take-after-fighting-ends-before-city-life-gets-back-to-normal-businesses-operating-at-prewar-levels-population-growth-etc/answer/Shawn-H-Hall\",\"viewerCanRestoreAnswer\":false,\"originalQuestionIfDifferent\":null,\"__isMonetizable\":\"Answer\",\"oid\":10527979,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjY5NDE1MzEy\",\"uid\":69415312,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"