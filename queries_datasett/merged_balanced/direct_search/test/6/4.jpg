eOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":172559564,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"11\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjEy\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6NDgwMjk3OTg=\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":8,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\"},\"answer\":{\"originalQuestionIfDifferent\":{\"question\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\",\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers? Would they clear the buildings one by one?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE5ODYyOTM1Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":198629357},\"slug\":\"How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"debugInfo\":\"{}\",\"viewer\":{\"user\":null,\"id\":\"Vmlld2VyQDA6MA==\"}},\"id\":\"T3JpZ2luYWxseUFuc3dlcmVkUXVlc3Rpb25AMDo0ODAyOTc5ODoxNTE3NDI4Mg==\",\"originalQuestionText\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionBannerRemoved\":false},\"id\":\"QW5zd2VyQDA6NDgwMjk3OTg=\",\"aid\":48029798,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"It would be a nightmare. Worse than Stalingrad. I would suggest bypassing it or lay siege. One possibility would be to allow the enemy to retreat out of the city to spare the population.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Helicopter insertion on roof tops would be needed to allow you to clear buildings from both the top and bottom.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"You also forgot about the myriad of tunnels and sewers large many large metropolitan cities have. In NYC, some digging tools (a bit of explosives would definitely help) may allow you to access sewers, utility tunnels and subway tunnels from basements of large buildings.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|1274309532\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-48029798_fa366313e0e941b0f5ece6543e51abf4\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":