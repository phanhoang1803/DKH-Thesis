zMTQyNA==\",\"uid\":302531424,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6MzAyNTMxNDI0OkxBVE4=\",\"reverseOrder\":false,\"givenName\":\"Yeuk\",\"familyName\":\"C. Moy\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Yeuk-C-Moy\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-302531424-50-zocsabfpzqbzgbnfwrltqjznmokoilew.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-302531424-200-zocsabfpzqbzgbnfwrltqjznmokoilew.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1497991784952127,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"U2Nob29sQ3JlZGVudGlhbEAwOjEwNzQ5MzE4MQ==\",\"__typename\":\"SchoolCredential\",\"__isCredential\":\"SchoolCredential\",\"translatedString\":\"studied Graduate Studies in Environmental and Waste Management at Stony Brook University\",\"endYear\":null,\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":107493181,\"concentration\":{\"tid\":6229283,\"id\":\"VG9waWNAMDo2MjI5Mjgz\",\"__typename\":\"Topic\",\"name\":\"Graduate Studies in Environmental and Waste Management\"},\"concentrationName\":null,\"degree\":\"\",\"school\":{\"tid\":7438,\"id\":\"VG9waWNAMDo3NDM4\",\"__typename\":\"Topic\",\"name\":\"Stony Brook University\"},\"schoolName\":null,\"secondConcentration\":null,\"secondConcentrationName\":null},\"isTranslated\":false,\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Yeuk-C-Moy\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDo0ODAyOTc5ODpbNzU5NSwgNDYyMTkyMV0=\",\"viewCount\":4621921,\"answerCount\":7595}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":6546,\"__isVotable\":\"Answer\",\"numUpvotes\":139,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":48029798,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"12\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjEz\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MzYwNjkwNDc1\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":9,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":108647563,\"id\":\"UXVlc3Rpb25AMDoxMDg2NDc1NjM=\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MzYwNjkwNDc1\",\"aid\":360690475,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"It all depends on the country and situation. A lot has been said about nations never fully rebuilding, but you only have to look at Germany and Japan to see what bullshit that is!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Germany was ripped apart at the seams, her cities devastated. Her infrastructure non existent and fifty million refugees created during that conflict.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Japan was defeated and hobbled but not as much as Germany, yet head out to buy a computer, car, washing machine or any other machine and it'll have German or Japanese manufacturers!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"It took both nations twenty years.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Yes, the rebuild was paid for by the United States, but it was those nations that did the work!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"A massive amount depends on the nation rebuilding.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"I spent three years in Iraq after Desert Storm and saw two Kurdish tribes rebuilding, one Saddam had always controlled, consequently he gave them what they needed, and when they had to rebuild themselves they couldn't! They didn't know how to, and this was despite millions of dollars being poured it both legally and illegally.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The other he'd never controlled. He gave them nothing, so they got used to having nothing and built a society with a thriving economy anyway. When the crunch came, they rebuilt with almost no help!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"It all depends on the nation and the situation. No amount of money or time can fix what the people think they can't fix!\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|607719916\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-360690475_7018869bbfff17416c320820be8cce70\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":108647563,\"id\":\"UXVlc3Rpb25AMDoxMDg2NDc1NjM=\",\"isDeleted\":false,\"url\":\"/How-long-does-it-take-for-a-country-city-to-rebuild-after-a-war-or-conflict\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How long does it take for a country/city to rebuild after a war or conflict?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjM3ODU0NTg3MA==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":378545870},\"slug\":\"How-long-does-it-take-for-a-country-city-to-rebuild-after-a-war-or-conflict\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":6,\"sugges