{\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjU4MDYyOTE2\",\"uid\":58062916,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6NTgwNjI5MTY6TEFUTg==\",\"reverseOrder\":false,\"givenName\":\"James\",\"familyName\":\"W. Hoover\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/James-W-Hoover\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-58062916-50-ytcifxfyoofttajkykzfvadhilzzauyj.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-58062916-200-ytcifxfyoofttajkykzfvadhilzzauyj.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":false,\"creationTime\":1575558451902650,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"V29ya0NyZWRlbnRpYWxAMDo4NjM3MjgyMA==\",\"__typename\":\"WorkCredential\",\"__isCredential\":\"WorkCredential\",\"translatedString\":\"History Professor in the U.S.  (2001-present)\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":86372820,\"position\":\"History Professor in the U.S. \",\"endYear\":\"-1\",\"companyName\":null,\"company\":null,\"startYear\":\"2001\"},\"isTranslated\":false,\"url\":\"/What-factors-and-why-could-prevent-or-discourage-civilians-from-fleeing-a-war-zone-in-the-context-of-a-dense-urban-area-in-a-first-second-world-country/answer/James-W-Hoover\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoxODQ1MzkwNDk6WzU5NTUsIDE1NDEwNTQ5XQ==\",\"viewCount\":15410549,\"answerCount\":5955}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":132,\"__isVotable\":\"Answer\",\"numUpvotes\":1,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":184539049,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"30\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjMx\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTEwNTU4NDU0\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":27,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":38262010,\"id\":\"UXVlc3Rpb25AMDozODI2MjAxMA==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTEwNTU4NDU0\",\"aid\":110558454,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"I That is close to martial law or what rural life is like for the most part.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"For cities, a night out would become afternoon out. Concerts would be scheduled at 10 AM. Night life would focus on weekends.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Police departments would be expanded, Tripled could be typical. Who would enforce a curfew otherwise.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Who would pay for the civic expenses? Taxes would rise. Teenagers would be caught violating the curfew and put in jail. More expenses and taxes would ensue.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Violent crimes typically done at night would become more common in daylight.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"For people who work 9 to 5, there would be little change initially. For others, they could become criminals. As taxes rise there would be recriminations. Some would blame the outlaws for the rise in crime. Feeling that they are virtuous citizens because they do not violate the law, some would applaud the incarceration of others. A police state of mind could take over.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"As the cost of incarceration increases there would be pressure to either release violators or do away with them. In an extreme case, death penalties for curfew violations could be enacted.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Again law abiding citizens could feel ok with this, they have not violated the law.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Where would that leave society?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|451613960\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-110558454_f4babfeb041daabf865fee370cb6de69\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":38262010,\"id\":\"UXVlc3Rpb25AMDozODI2MjAxMA==\",\"isDeleted\":false,\"url\":\"/How-would-a-citys-economy-be-affected-by-a-permanent-dusk-to-dawn-curfew-How-might-businesses-and-civilian-life-change\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How would a city's economy be affected by a permanent dusk to dawn curfew? How might businesses and civilian life change?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjExMjY5MzEwMw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":112693103},\"slug\":\"How-would-a-citys-economy-be-affected-by-a-permanent-dusk-to-dawn-curfew-How-might-businesses-and-civilian-life-change\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":1,\"suggestedReplies\":[]},\"permaUrl\":\"/How-would-a-citys-economy-be-affected-by-a-permanent-dusk-to-dawn-curfew-How-might-businesses-and-civilian-life-change/answer/Ron-Leavitt\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/How-would-a-citys-economy-be-affected-by-a-permanent-dusk-to-dawn-curfew-How-might-businesses-and-civilian-life-change/answer/Ron-Leavitt\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":110558454,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helpline