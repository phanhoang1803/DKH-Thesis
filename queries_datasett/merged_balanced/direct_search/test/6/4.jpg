rl\":null,\"smallProfileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"profileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":false,\"creationTime\":1447161013934305,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TGlmZUV4cGVyaWVuY2VDcmVkZW50aWFsQDA6Mjg3MTA4MzI=\",\"__typename\":\"LifeExperienceCredential\",\"__isCredential\":\"LifeExperienceCredential\",\"translatedString\":\"lived in a city\",\"experience\":{\"id\":\"VG9waWNAMDo0MzEx\",\"__typename\":\"Topic\",\"tid\":4311,\"name\":\"Cities and Metropolitan Areas\"},\"description\":\"lived in a city\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":28710832},\"isTranslated\":false,\"url\":\"/How-well-would-towns-and-cities-be-able-to-function-independently/answers/16906210\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoxNjkwNjIxMDpbMjI0LCAxNjU2MDRd\",\"viewCount\":165604,\"answerCount\":224}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":84,\"__isVotable\":\"Answer\",\"numUpvotes\":0,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":true,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":16906210,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"33\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjM0\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6NTMyOTE1MTU=\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":30,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":17913312,\"id\":\"UXVlc3Rpb25AMDoxNzkxMzMxMg==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6NTMyOTE1MTU=\",\"aid\":53291515,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"It is different with every nation and every war. World War II saw a lot of support on the home front. British civilians and German civilians had to deal with air raids on their homes. Although that is highly unlikely to happen to a developed country in a modern war.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"When war begins, governments will usually start slowly focusing production on tech and defense/offense. The US would most likely never start another draft if that is what you are worried about.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"It could mean more factory jobs or it could mean a collapse of the economy. It\\\\u2019s quite hard to tell.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|1720279750\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-53291515_3ca886806debdf2f8799d34558080c89\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":17913312,\"id\":\"UXVlc3Rpb25AMDoxNzkxMzMxMg==\",\"isDeleted\":false,\"url\":\"/How-does-war-change-civilian-lives-What-happens-with-them-from-the-start-till-the-end-of-a-war\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How does war change civilian lives? What happens with them from the start till the end of a war?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE4NzAwMTE2Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":187001167},\"slug\":\"How-does-war-change-civilian-lives-What-happens-with-them-from-the-start-till-the-end-of-a-war\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":1,\"suggestedReplies\":[]},\"permaUrl\":\"/How-does-war-change-civilian-lives-What-happens-with-them-from-the-start-till-the-end-of-a-war/answer/Mach-Ten\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/How-does-war-change-civilian-lives-What-happens-with-them-from-the-start-till-the-end-of-a-war/answer/Mach-Ten\",\"viewerCanRestoreAnswer\":false