ctSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjQ1NTcyNzc5OQ==\",\"uid\":455727799,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6NDU1NzI3Nzk5OkxBVE4=\",\"reverseOrder\":false,\"givenName\":\"Bill\",\"familyName\":\"Lamp\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Bill-Lamp\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-455727799-50-cjqwzldxexxhqrbsjtzwfhocdignxgtx.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-455727799-200-cjqwzldxexxhqrbsjtzwfhocdignxgtx.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1610888406476657,\"hasSuicideTopics\":false,\"updatedTime\":1610888478944987,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"V29ya0NyZWRlbnRpYWxAMDoxMTA2NjIyNjM=\",\"__typename\":\"WorkCredential\",\"__isCredential\":\"WorkCredential\",\"translatedString\":\"Wonderfully Retired\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":110662263,\"position\":\"Wonderfully Retired\",\"endYear\":\"-1\",\"companyName\":null,\"company\":null,\"startYear\":null},\"isTranslated\":false,\"url\":\"/Do-people-live-relatively-normal-lives-during-wars-If-you-are-not-in-the-middle-of-a-warzone-do-you-keep-going-with-your-business-as-usual-Not-talking-about-disruptions-in-supply-chains-some-possible-military/answer/Bill-Lamp\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoyNjAzOTkzNTU6WzYzNSwgOTc2NTVd\",\"viewCount\":97655,\"answerCount\":635}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":526,\"__isVotable\":\"Answer\",\"numUpvotes\":2,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":260399355,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"29\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjMw\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTg0NTM5MDQ5\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":26,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":62106037,\"id\":\"UXVlc3Rpb25AMDo2MjEwNjAzNw==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTg0NTM5MDQ5\",\"aid\":184539049,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"If it\\\\u2019s a large city, simple lack of transportation could trap a huge number of people. There would only be so many trains out, so many aircraft, boats, etc., and not everyone (especially in a large city) owns a car. A lot of people simply can\\\\u2019t afford to evacuate. Then there are stubborn people, who stay put no matter what. Much also depends on context. At Leningrad, in World War II, you were evacuated if the Soviets said you could be, but many civilian workers were forced to remain at their jobs in the city. In London, children were evacuated from the city (my mother among them), but that was often a bit of a fiasco. What if the city is full of people who want to be liberated by the attacking army? What if it\\\\u2019s winter, and you\\\\u2019d literally freeze to death in a foodless, shelterless wasteland if you left the city? Imagine a city of 6 million people, surrounded by a generally rural area. Where are all those people going to go? In certain climates, shelter is crucial. Rural areas also don\\\\u2019t exactly have supplies. Sure, they might grow crops, but often they only grow one or two things, and they wouldn\\\\u2019t have enough for 6 million people in any event. There are a lot of scenarios in which civilians might be better off taking their chances in the city. If you look at major refugee crises in modern wars (even in more developed lands), you see right away that flight isn\\\\u2019t always a pathway to safety. The reality, though, is that if a city becomes a battleground, for any length of time, its infrastructure will begin to break down, and it will quickly become very difficult to live there. Water and electricity will fail, and with it the city\\\\u2019s sanitation systems, and even automatic fire suppression. Broken water mains and sewers will cause floods, while fires will burn out of control. High rise structures, including many apartments, would quickly become almost uninhabitable.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-810340810\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-184539049_d66f90dea05c30b4af55e6126caf3c10\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":62106037,\"id\":\"UXVlc3Rpb25AMDo2MjEwNjAzNw==\",\"isDeleted\":false,\"url\":\"/What-factors-and-why-could-prevent-or-discourage-civilians-from-fleeing-a-war-zone-in-the-context-of-a-dense-urban-area-in-a-first-second-world-country\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"What factors (and why) could prevent or discourage civilians from fleeing a war zone (in the context of a dense urban area in a first/second world country)?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjcyMTY2NTk1Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":721665957},\"slug\":\"What-factors-and-why-could-prevent-or-discourage-civilians-from-fleeing-a-war-zone-in-the-context-of-a-dense-urban-area-in-a-first-second-world-country\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":6,\"suggestedReplies\":[]},\"permaUrl\":\"/What-factors-and-why-could-prevent-or-discourage-civilians-from-fleeing-a-war-zone-in-the-context-of-a-dense-urban-area-in-a-first-second-world-country/answer/James-W-Hoover\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUr