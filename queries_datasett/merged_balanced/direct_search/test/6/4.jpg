ttps://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":8,\"__isReportable\":\"Answer\",\"reportableId\":171906099,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"6\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjc=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"relatedQuestions\":[{\"id\":\"UXVlc3Rpb25AMDoxMDU2MDk3Nw==\",\"__typename\":\"Question\",\"qid\":10560977,\"url\":\"/Why-dont-governments-set-a-maximum-population-per-city\",\"slug\":\"Why-dont-governments-set-a-maximum-population-per-city\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Why don't governments set a maximum population per city?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjEyMjc3OTE4\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":12277918},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDoyNjE2NDU5Mg==\",\"__typename\":\"Question\",\"qid\":26164592,\"url\":\"/Should-war-be-conducted-against-both-military-and-civilian-populations\",\"slug\":\"Should-war-be-conducted-against-both-military-and-civilian-populations\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Should war be conducted against both military and civilian populations?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjQzNjIzNTMwOQ==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":436235309},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDoyNjA0MzI3\",\"__typename\":\"Question\",\"qid\":2604327,\"url\":\"/What-are-the-best-examples-of-very-small-armies-defeating-larger-ones\",\"slug\":\"What-are-the-best-examples-of-very-small-armies-defeating-larger-ones\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"What are the best examples of very small armies defeating larger ones?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjU5OTU3NjY1\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":59957665},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDo0MjAxNzcxOA==\",\"__typename\":\"Question\",\"qid\":42017718,\"url\":\"/What-is-the-costliest-war-in-terms-of-population-percentage\",\"slug\":\"What-is-the-costliest-war-in-terms-of-population-percentage\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"What is the costliest war in terms of population percentage?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE0NDU3NTEzNA==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":144575134},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null},{\"id\":\"UXVlc3Rpb25AMDoxMzI2MDI=\",\"__typename\":\"Question\",\"qid\":132602,\"url\":\"/Why-does-a-countrys-population-always-have-to-grow-in-order-to-be-considered-successful\",\"slug\":\"Why-does-a-countrys-population-always-have-to-grow-in-order-to-be-considered-successful\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Why does a country's population always \\\\\\\"have to grow\\\\\\\" in order to be considered successful?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjUxNjEwMQ==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":516101},\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null}],\"id\":\"UXVlc3Rpb25JbmxpbmVSZWxhdGVkUXVlc3Rpb25zSXRlbUAwOjM1MDc4MDk6aW5saW5lX2xpbmtzOjQ=\",\"__typename\":\"QuestionInlineRelatedQuestionsItem\",\"__isQuestionPagedListItem\":\"QuestionInlineRelatedQuestionsItem\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"__typename\":\"Question\"},\"hashSuffix\":\"1623133269\"},\"cursor\":\"7\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjg=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTcyMTIwMzk2\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":4,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":58005085,\"id\":\"UXVlc3Rpb25AMDo1ODAwNTA4NQ==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTcyMTIwMzk2\",\"aid\":172120396,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"My now wife was about 7 years old when Saddam invaded Kuwait in 1990. Her family continued to live through the Iraqi occupation of Kuwait as well as the first gulf war, or Desert Storm.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"My father-in-law worked for the Kuwait military at that time. On the day of the invasion, he went to work as usual only to find all his Kuwaiti commanders had disappeared, leaving lower cadre like himself completely unaware and exposed. Like other soldiers, he took off his uniform and decided to walk home. At Iraqi checkpoints along the way, he told the soldiers that he was a trader who had been looted by other Iraqi soldiers. They let him pass. Took him a day to get home.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The extended family (uncles, aunts, cousins) moved into a large villa that had a basement they\\\\u2019d go into during air raids by the allied forces. There was no school of course during this time. The Iraqis for the most part left Indians alone and would sometimes drop in to ask for \\\\u2018Amitabh Bachman\\\\u2019 video cassettes.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"People generally went about doing whatever they could to earn money - selling supplies (looted from shops) outside mosques, bartering, planning their escape by road from the city, etc.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"I was about 11 years old then and safely far away from the war theatre in Jeddah, Saudi Arabia; except that our home was very close to an American airbase. We\\\\u2019d regularly see several B-52 bombers flying in formation, apache helicopters and fighter jets fly real low and close to our buildings. It was an exciting time for us kids. My brother and I would know what times the planes would arrive and go up to the terrace to wait for them to scream past. We\\\\u2019d try and see if we could be louder than the jets.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"We weren\\\\u2019t. The jets won each time.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-664089108\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-172120396_e705783a06d38cce3a2222b7f2c97a4f\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":58005085,\"id\":\"UXVlc3Rpb25AMDo1ODAwNTA4NQ==\",\"isDeleted\":false,\"url\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When a city is captured in war, do people go to work like normal? How do the people pay for their food?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjIyMTAwMTE1Mw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":221001153},\"slug\":\"When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":7,\"suggestedReplies\":[]},\"permaUrl\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food/answers/172120396\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food/answers/172120396\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":172120396,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjk2OTA1MDYw\",\"uid\":96905060,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":null,\"smallProfileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"profileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"enabled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1570300234842731,\"hasSuicideTopics\":false,\"updatedTime\":1570483325175729,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TG9jYXRpb25DcmVkZW50aWFsQDA6NTAwODI3MDU=\",\"__typename\":\"LocationCredential\",\"__isCredential\":\"LocationCredential\",\"translatedString\":\"lived in Saudi Arabia (1979-1995)\",\"startYear\":\"1979\",\"endYear\":\"1995\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"locationName\":null,\"location\":{\"id\":\"VG9waWNAMDo4NDYw\",\"__typename\":\"Topic\",\"tid\":8460,\"name\":\"Saudi Arabia\"}},\"isTranslated\":false,\"url\":\"/When-a-city-is-captured-in-war-do-people-go-to-work-like-normal-How-do-the-people-pay-for-their-food/answers/172120396\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoxNzIxMjAzOTY6WzUyMiwgNDI2OTI5MF0=\",\"viewCount\":4269290,\"answerCount\":522}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"smart_distribution\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":1517,\"__isVotable\":\"Answer\",\"numUpvotes\":20,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":172120396,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"8\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjk=\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6NDQzNTE5NzQ=\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":5,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\"},\"answer\":{\"originalQuestionIfDifferent\":{\"question\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\",\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers? Would they clear the buildings one by one?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE5ODYyOTM1Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":198629357},\"slug\":\"How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"debugInfo\":\"{}\",\"viewer\":{\"user\":null,\"id\":\"Vmlld2VyQDA6MA==\"}},\"id\":\"T3JpZ2luYWxseUFuc3dlcmVkUXVlc3Rpb25AMDo0NDM1MTk3NDoxNTE3NDI4Mg==\",\"originalQuestionText\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionBannerRemoved\":false},\"id\":\"QW5zd2VyQDA6NDQzNTE5NzQ=\",\"aid\":44351974,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"In my mind, there are a few possibilities, modeled after some real-world battles.\\\", \\\"modifiers\\\": {\\\"bold\\\": true}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Firstly, if there are many buildings, who says they can\\\\u2019t be destroyed?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Unfortunately, that is what we have with modern technology.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Battle of Stalingrad\\\", \\\"modifiers\\\": {\\\"italic\\\": true}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\", \\\"modifiers\\\": {\\\"image\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-64fe358dfdb4bdf49a14488e515b8337-lq\\\", \\\"height\\\": 768, \\\"width\\\": 1024, \\\"master_url\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-c6f251b86cdb7f0579b540635f6fc80e-c\\\", \\\"is_deleted\\\": false, \\\"is_sensitive\\\": false, \\\"is_uploaded_by_bot\\\": false, \\\"zoomable\\\": true, \\\"dominant_color\\\": \\\"#f7f7f7\\\"}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"image\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"(Present) Syria conflict\\\", \\\"modifiers\\\": {\\\"italic\\\": true}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\", \\\"modifiers\\\": {\\\"image\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-6701b89dfd7917f48355eac1943b5901-lq\\\", \\\"height\\\": 1365, \\\"width\\\": 2048, \\\"master_url\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-c82ff6f99414755b33feb0fc0a04e32b-c\\\", \\\"is_deleted\\\": false, \\\"is_sensitive\\\": false, \\\"is_uploaded_by_bot\\\": false, \\\"zoomable\\\": true, \\\"dominant_color\\\": \\\"#fbfbfa\\\"}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"image\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Typically, in these types of battles, there is a lot of hand-to-hand and street-fighting in combat. For example, in the Battle of Stalingrad, soldiers advancing through the city had to clear out each building and take the city street-by-street, in an agonizingly slow and highly dangerous way.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In a modern super-city like Hong Kong filled with skyscrapers, an advancing army simply would not be able to clear out every building like the Germans attempted in WW2. Any army would simply have to storm the city and expect the cooperation of \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"most \\\", \\\"modifiers\\\": {\\\"italic\\\": true}}, {\\\"text\\\": \\\"citizens. Any rebels would probably get a few shots off then be put to death. It\\\\u2019s important to understand that most people do not want to try picking away at a superior force, and most people would cooperate with a superior army.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|773563780\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-44351974_b4bcf26fdc5fabad23d60452ec5cacd8\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":15174282,\"id\":\"UXVlc3Rpb25AMDoxNTE3NDI4Mg==\",\"isDeleted\":false,\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How could a war be fought in a highly populated city with skyscrapers? Would they clear the buildings one by one?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE5ODYyOTM1Nw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":198629357},\"slug\":\"How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":39,\"suggestedReplies\":[]},\"permaUrl\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Jeffrey-Wang-126\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Jeffrey-Wang-126\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":44351974,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjIwNzA0NzI4Mg==\",\"uid\":207047282,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6MjA3MDQ3MjgyOkxBVE4=\",\"reverseOrder\":false,\"givenName\":\"Jeffrey\",\"familyName\":\"Wang\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Jeffrey-Wang-126\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-207047282-50-jqsefkbwhnokknkccgthdassyeeslety.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-207047282-200-jqsefkbwhnokknkccgthdassyeeslety.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"enabled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1494690560380432,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TGlmZUV4cGVyaWVuY2VDcmVkZW50aWFsQDA6MTA2NjgxNzI5\",\"__typename\":\"LifeExperienceCredential\",\"__isCredential\":\"LifeExperienceCredential\",\"translatedString\":\"Amateur Historian\",\"experience\":{\"id\":\"VG9waWNAMDo5MzA=\",\"__typename\":\"Topic\",\"tid\":930,\"name\":\"History\"},\"description\":\"Amateur Historian\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":106681729},\"isTranslated\":false,\"url\":\"/How-could-a-war-be-fought-in-a-highly-populated-city-with-skyscrapers-Would-they-clear-the-buildings-one-by-one/answer/Jeffrey-Wang-126\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDo0NDM1MTk3NDpbMjA2LCA0Nzk2MjIyXQ==\",\"viewCount\":4796222,\"answerCount\":206}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":4785,\"__isVotable\":\"Answer\",\"numUpvotes\":110,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":4,\"__isReportable\":\"Answer\",\"reportableId\":44351974,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"9\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjEw\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MjYwMzYwNjMw\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":6,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":84994368,\"id\":\"UXVlc3Rpb25AMDo4NDk5NDM2OA==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MjYwMzYwNjMw\",\"aid\":260360630,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"The answer to this question depends a lot on what type of war you're talking about and where you're living relative to this war. You've specified that you're interested in people who are not \\\\\\\"in the middle of a warzone\\\\\\\". I assume that what you mean by warzone is an area where there is active combat. Let's look at some different examples.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Consider the United States during World War II. All of the active combat was occurring in Europe or in the Pacific area. Almost none of the US was in an active warzone. And much of life went on pretty normally. Many men were missing because they had been drafted. Women had to do many jobs that had previously been done by these missing men. There were shortages of many things because they were needed for the war effort and everyone had to adjust to rationing. But most of life was pretty normal for those living in the US.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Now, consider Europe after the Germans had occupied most of the continent. After the Allies landed in Normandy and in Italy, there were active warzones on the continent. However, there were fairly well defined battle fronts and most of the fighting was confined to those front lines. People living in the interior of Europe at that time could be thought of as not living in a \\\\\\\"warzone\\\\\\\". However, their situation was very different from what it was for people living in the US.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"People that were well away from the front lines tried to live as normal as possible. They tried to have school for the children and they tried to stage plays and recitals to have some entertainment. However, nothing was really \\\\\\\"as usual\\\\\\\". Try reading some biographies of people who lived in parts of Europe that were occupied by the Germans.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"First, a lot of men were missing, more than the number missing in the US. Many got drafted and were forced to fight in the enemy's army. For those living in or near industrial areas, many men and some women were forced to work in the enemy's war-related industries. For those who didn't want to do either of those, they had to go into hiding.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"One of the biggest problems in Europe was one that you have tried to ignore by saying that you didn't want to talk about disruptions in supply chains. This was a much bigger problem in Europe during World War II and it had a major impact on everyone's \\\\\\\"usual\\\\\\\" life. It can't really be ignored.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Most of an area's food, fuel oil, gasoline and vehicles were commandeered and turned over to the military. People had to spend a tremendous amount of time just trying to scrounge and hide food. They were often close to starvation. In the winter, they were also often close to freezing because they had no reliable way to heat their houses. This was not a small disruption. It's hard to live a normal life when you're always hungry and trying to find food.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"And then there was the \\\\\\\"possible military presence\\\\\\\" that you also didn't want to hear about. In Europe, any military presence was \\\\\\\"the enemy\\\\\\\". They were everywhere. Among other things, they were looking for people hoarding food or for people hiding from the draft. If they caught someone involved in either of these activities there would be punishments. Sometimes people were executed, just to provide a lesson to those left.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In Europe during World War II, there wasn't a lot of business as usual, even if you weren't near a battle front.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Now consider some modern warfare areas like Iraq or Afghanistan. Like with most wars, there are shortages of many things that people would like to have. People living there have to learn to deal with these shortages. But there's a big difference in these areas compared to Europe in World War II. There are now no well defined front lines. The nature of warfare has changed. Fighting could erupt almost anywhere at almost any time. A car bomb could be detonated in the middle of a crowded market place just because some group thought it was a good idea.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Again, people are going to try to conduct business as usual as much as they can. However, in a sense these entire countries have to be considered as active warzones.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|1900579054\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-260360630_3522f9bc54d71fcbba57a9d939423d1a\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":84994368,\"id\":\"UXVlc3Rpb25AMDo4NDk5NDM2OA==\",\"isDeleted\":false,\"url\":\"/Do-people-live-relatively-normal-lives-during-wars-If-you-are-not-in-the-middle-of-a-warzone-do-you-keep-going-with-your-business-as-usual-Not-talking-about-disruptions-in-supply-chains-some-possible-military\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Do people live relatively normal lives during wars? If you are not in the middle of a warzone, do you keep going with your business as usual? Not talking about disruptions in supply chains, some possible military presence, etc\\\\u2026\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjY1NjYyOTMxMQ==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":656629311},\"slug\":\"Do-people-live-relatively-normal-lives-during-wars-If-you-are-not-in-the-middle-of-a-warzone-do-you-keep-going-with-your-business-as-usual-Not-talking-about-disruptions-in-supply-chains-some-possible-military\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":4,\"suggestedReplies\":[]},\"permaUrl\":\"/Do-people-live-relatively-normal-lives-during-wars-If-you-are-not-in-the-middle-of-a-warzone-do-you-keep-going-with-your-business-as-usual-Not-talking-about-disruptions-in-supply-chains-some-possible-military/answer/Tim-Johnson-898\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/Do-people-live-relatively-normal-lives-during-wars-If-you-are-not-in-the-middle-of-a-warzone-do-you-keep-going-with-your-business-as-usual-Not-talking-about-disruptions-in-supply-chains-some-possible-military/answer/Tim-Johnson-898\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":260360630,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your 