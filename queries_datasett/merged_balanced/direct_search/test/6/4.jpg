"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDozNTI5OTQ0MTU6WzI4MDksIDM2NzgyMDFd\",\"viewCount\":3678201,\"answerCount\":2809}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":108,\"__isVotable\":\"Answer\",\"numUpvotes\":2,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":1,\"__isReportable\":\"Answer\",\"reportableId\":352994415,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"23\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjI0\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6NjkyMjYzMw==\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":20,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":2081559,\"id\":\"UXVlc3Rpb25AMDoyMDgxNTU5\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6NjkyMjYzMw==\",\"aid\":6922633,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Extremely variable.  \\\\n \\\\nBritain lost ground globally after both world wars, despite having won them.   The USA boomed.\\\\n  \\\\nAfter World War Two, West Germany and Italy and Japan had economic miracles, partly because the USA spent a lot to keep them loyal in the Cold War.\\\\n \\\\nGermany had a lot of economic troubles after World War One and arguably never did recover under the Weimar Republic.  Hitler was quite successful as a peacetime leader, but suffered the delusion he would be a brilliant war leader.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-829450743\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-6922633_873c926ab1a206e57a3578e49d29c634\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":2081559,\"id\":\"UXVlc3Rpb25AMDoyMDgxNTU5\",\"isDeleted\":false,\"url\":\"/How-long-does-it-take-for-a-country-to-recover-and-grow-its-economy-after-a-war\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How long does it take for a country to recover and grow its economy after a war?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjQxMjYzMjE=\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":4126321},\"slug\":\"How-long-does-it-take-for-a-country-to-recover-and-grow-its-economy-after-a-war\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":2,\"suggestedReplies\":[\"What are some successful examples of post-war economic recovery?\",\"How does in