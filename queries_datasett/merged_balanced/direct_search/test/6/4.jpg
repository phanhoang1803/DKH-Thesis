"isBad\":false,\"isEnqueued\":false,\"credentialId\":32881312},\"isTranslated\":false,\"url\":\"/Is-it-disadvantage-to-have-huge-population-when-your-country-is-at-war/answer/Joshua-Field-2\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoyNTIxNTg3MzpbMTEwLCAyMzM5MjE3XQ==\",\"viewCount\":2339217,\"answerCount\":110}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":1963,\"__isVotable\":\"Answer\",\"numUpvotes\":7,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":2,\"__isReportable\":\"Answer\",\"reportableId\":25215873,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"27\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjI4\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTEwODAxNjc3\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":24,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":38336175,\"id\":\"UXVlc3Rpb25AMDozODMzNjE3NQ==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTEwODAxNjc3\",\"aid\":110801677,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Immediately yes, but not for long.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"An example would be France following World War I. There, they lost around a quarter of the men of an entire generation. But following most wars, you have a massive creation of wealth that comes about from new opportunities, if for no other reason than starting up businesses and rebuilding cities. It is also a nice opportunity, tragic as is, to reorganize society to be more efficient in how it uses resources.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"This fuels spending and investment from the now disproportionately large elderly class into the hands of the remaining younger a...\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|329383984\",\"viewerHasAccess\":false,\"feedbackSurveyVariant\":23,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-110801677_87a8017b7edbfb23550951d4178a8121\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":38336175,\"id\":\"UXVlc3Rpb25AMDozODMzNjE3NQ==\",\"isDeleted\":false,\"url\":\"/Do-wars-age-the-population-by-wiping-out-the-young\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Do wars age the population by wiping out the young?\\\