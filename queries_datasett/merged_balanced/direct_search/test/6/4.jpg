\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Harry-Stevens-5\",\"smallProfileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"profileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"never_enrolled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1580846144743833,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"U2Nob29sQ3JlZGVudGlhbEAwOjEwNzU1ODA0OA==\",\"__typename\":\"SchoolCredential\",\"__isCredential\":\"SchoolCredential\",\"translatedString\":\"studied at University of Chicago (2023)\",\"endYear\":\"2023\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":107558048,\"concentration\":null,\"concentrationName\":null,\"degree\":\"\",\"school\":{\"tid\":2097,\"id\":\"VG9waWNAMDoyMDk3\",\"__typename\":\"Topic\",\"name\":\"University of Chicago\"},\"schoolName\":null,\"secondConcentration\":null,\"secondConcentrationName\":null},\"isTranslated\":false,\"url\":\"/How-do-populations-deal-with-constant-war/answer/Harry-Stevens-5\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDoxOTYxMzU4ODY6WzI5NywgNDA1MDQ0XQ==\",\"viewCount\":405044,\"answerCount\":297}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":194,\"__isVotable\":\"Answer\",\"numUpvotes\":0,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":196135886,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"16\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjE3\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTQ3Nzc0MzgyOTI4MTYxOQ==\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":13,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":203966370,\"id\":\"UXVlc3Rpb25AMDoyMDM5NjYzNzA=\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTQ3Nzc0MzgyOTI4MTYxOQ==\",\"aid\":1477743829281619,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Peace be upon you and God's mercy and blessings.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Ah, humans, the great contradiction of creation. Created with intellect yet swayed by the shallow whispers of propaganda. Why do they walk into wars, these rivers of blood, with open eyes and clenched fists, as if marching to salvation but finding only fire? Maybe because humans forget\\\\u2014forget that Allah has given them minds to think, hearts to feel, and a fitrah (natural disposition) to seek peace. But no, they follow banners waved by men in suits and uniforms, who promise glory while sharpening swords behind their backs.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The Qur'an already warned us:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\\\\"And do not follow that of which you have no knowledge. Indeed, the hearing, the sight, and the heart\\\\u2014about all those [one] will be questioned.\\\\\\\" (Surah Al-Isra 17:36).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"But here we are, a people who hear the war drums and lose their minds. Leaders shout, \\\\\\\"They are our enemies!\\\\\\\" and suddenly neighbors turn into threats, lands into battlefields, and lies into truths. Do people not realize that most wars are the playground of greed, the games of power-hungry elites? The Prophet Muhammad (peace be upon him) said, \\\\\\\"A Muslim is the brother of another Muslim. He does not oppress him nor hand him over to his enemy.\\\\\\\" (Bukhari & Muslim). Yet we find nations divided by lines drawn by colonial hands, spilling each other\\\\u2019s blood over disputes that are not their own.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Propaganda, that sweet poison. Leaders wave flags, sing anthems, and talk about honor and freedom. Oh, the irony! Freedom bought with slavery to destruction? Honor gained by dishonoring humanity? Allah reminds us:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\\\\"O you who have believed, obey Allah and obey the Messenger and those in authority among you. And if you disagree over anything, refer it to Allah and the Messenger, if you should believe in Allah and the Last Day.\\\\\\\" (Surah An-Nisa 4:59).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"But no, people prefer to obey power over principles, forgetting that authority without justice is nothing but tyranny.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"History repeats itself, doesn\\\\u2019t it? Pharaohs, Caesars, colonizers\\\\u2014they all had the same script. Stir the masses with fear, promise them security, and watch them march like sheep to their own slaughter. Allah recounts the arrogance of Pharaoh:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\\\\"He said, 'I do not show you except what I see, and I do not guide you except to the way of right conduct.'\\\\\\\" (Surah Ghafir 40:29).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"And the people? They believed him. They believed a man who enslaved and oppressed them because it was easier than thinking for themselves.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"But let\\\\u2019s not act like we\\\\u2019re any better today. Social media, the new war drum. News channels, the new battlefront. Leaders no longer ride horses into war; they sit in air-conditioned offices and play chess with the lives of millions. The Qur'an hits us with the truth:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\\\\"Indeed, Pharaoh exalted himself in the land and made its people into factions, oppressing a group among them, slaughtering their [newborn] sons and keeping their females alive. Indeed, he was of the corrupters.\\\\\\\" (Surah Al-Qasas 28:4).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Sounds familiar, doesn\\\\u2019t it? Divide and conquer\\\\u2014the oldest trick in the book, yet we fall for it every time.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Why do populations allow it? Fear, laziness, and ignorance, the unholy trinity. Fear of the unknown enemy, laziness to seek the truth, and ignorance about the consequences. The Prophet (peace be upon him) warned us: \\\\\\\"There will come a time when lying will become widespread, and people will believe the liar and disbelieve the truthful.\\\\\\\" (Ahmad). Look around\\\\u2014are we not living this hadith? Politicians lie, and the masses cheer. Scholars speak the truth, and the world silences them.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"And then there\\\\u2019s tribalism, that old disease. My nation, my religion, my race\\\\u2014above all else. Allah says:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\\\\"O mankind, indeed We have created you from male and female and made you peoples and tribes that you may know one another. Indeed, the most noble of you in the sight of Allah is the most righteous of you.\\\\\\\" (Surah Al-Hujurat 49:13).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"But do people listen? No. They wave their flags higher than their principles, forgetting that Allah will ask them not about their borders but about their deeds.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Yet there is hope. Hope that we remember the lessons of Islam: that justice is above nationalism, that peace is better than war, and that speaking the truth is a duty even when it\\\\u2019s against our leaders. The Prophet (peace be upon him) said: \\\\\\\"The best jihad is to speak a word of truth to a tyrannical ruler.\\\\\\\" (Abu Dawood). So, where are the brave hearts? Where are those who will stand and say, \\\\\\\"No, this war is not for us\\\\\\\"?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Wake up, O humanity. Wars may be waged by leaders, but they are fought by the poor, the oppressed, and the innocent. Stop marching to the beat of deception. Remember Allah, who says:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\\\\"And do not commit abuse on the earth, spreading corruption.\\\\\\\" (Surah Al-Baqarah 2:60).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"War, unless in self-defense, is corruption. It is a betrayal of the trust Allah has given us to be caretakers of this Earth.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"May Peace, Mercy, and Blessings of Allah be Upon You Also. \\\\ud83c\\\\udf0d\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|560060333\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-1477743829281619_7116dedf267cf32cd3e9b3726812a99f\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":203966370,\"id\":\"UXVlc3Rpb25AMDoyMDM5NjYzNzA=\",\"isDeleted\":false,\"url\":\"/Why-do-populations-allow-themselves-to-be-lead-into-wars-that-are-against-their-own-interest\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Why do populations allow themselves to be lead into wars that are against their own interest?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjE2MDgzNDMyMw==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":160834323},\"slug\":\"Why-do-populations-allow-themselves-to-be-lead-into-wars-that-are-against-their-own-interest\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":11,\"suggestedReplies\":[]},\"permaUrl\":\"/Why-do-populations-allow-themselves-to-be-lead-into-wars-that-are-against-their-own-interest/answer/Fajim-1\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/Why-do-populations-allow-themselves-to-be-lead-into-wars-that-are-against-their-own-inter