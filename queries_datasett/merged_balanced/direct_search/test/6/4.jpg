\\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjEwNjE5NDk4NDA=\",\"uid\":1061949840,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6MTA2MTk0OTg0MDpMQVRO\",\"reverseOrder\":false,\"givenName\":\"Lawrence\",\"familyName\":\"Hebb\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/Lawrence-Hebb\",\"smallProfileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-1061949840-50-pluqxobrucrtftuedujbyilfxcojkpsm.jpeg\",\"profileImageUrl\":\"https://qph.cf2.quoracdn.net/main-thumb-1061949840-200-pluqxobrucrtftuedujbyilfxcojkpsm.jpeg\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"enabled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1654691991138224,\"hasSuicideTopics\":false,\"updatedTime\":1654692236227908,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"V29ya0NyZWRlbnRpYWxAMDoxNDAzMjI0OTc=\",\"__typename\":\"WorkCredential\",\"__isCredential\":\"WorkCredential\",\"translatedString\":\"former Relief Worker. (1992-1996)\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":140322497,\"position\":\"Relief Worker.\",\"endYear\":\"1996\",\"companyName\":null,\"company\":null,\"startYear\":\"1992\"},\"isTranslated\":false,\"url\":\"/How-long-does-it-take-for-a-country-city-to-rebuild-after-a-war-or-conflict/answer/Lawrence-Hebb\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDozNjA2OTA0NzU6WzU2MiwgMTI0NTY1OF0=\",\"viewCount\":1245658,\"answerCount\":562}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":2546,\"__isVotable\":\"Answer\",\"numUpvotes\":2,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":1,\"requesters\":[{\"id\":\"VXNlckAwOjM3ODU0NTg3MA==\",\"__typename\":\"User\",\"uid\":378545870,\"isAnon\":false,\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6Mzc4NTQ1ODcwOkxBVE4=\",\"reverseOrder\":false,\"givenName\":\"Emirey\",\"familyName\":\"Jackson\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"profileUrl\":\"/profile/Emirey-Jackson\"}],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":360690475,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"13\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjE0\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MzYzNTM1MzI1\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":10,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":120342082,\"id\":\"UXVlc3Rpb25AMDoxMjAzNDIwODI=\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MzYzNTM1MzI1\",\"aid\":363535325,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Ignoring video games, because they\\\\u2019re irrelevant, in real life, cities are the graveyards of armies.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"I don\\\\u2019t think people appreciate the complexity and difficulty of \\\\u201ctaking\\\\u201d a modern city. I\\\\u2019ll give you an example to illustrate it. In the early 2000s, in Edmonton, Alberta, Canada, a disused military base surrounded by prime real estate was sold off to developers. Since all of the buildings were going to be knocked down anyway, the Canadian Army took advantage of the opportunity to do some intensive urban warfare training. We set up video cameras and instrumentation, equipped troops with MILES gear (essentially, an elaborate form of \\\\u201claser tag\\\\u201d that can record near-hits and hits from weapons, and which weapons they came from). We did tons of work-up training in urban ops. Then, by companies (about 130 soldiers in total), we rotated through a series of objectives in the old base. I was commanding one of those companies.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"My first objective was a two-story former elementary school. Each floor was probably about 3000 square feet, with about a dozen or so rooms\\\\u2014classrooms, mostly, but there were also offices, storage rooms, closets, and a boiler/mechanical room in a partial basement. Again, I had 130 soldiers to take the building, and about 2 hours to do it. It was defended by roughly two sections of enemy infantry (about 20 soldiers or so).\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"So I made my plan and launched the attack. We took about a half-dozen casualties breaching the building and getting a \\\\u201clodgement\\\\u201d (a foothold) inside it. While my weapons detachment (4 medium machine guns) kept the building isolated, so no bad guys could get in or out, my three platoons of infantry progressively entered the building and began to clear it.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"It took almost the full two hours. Our casualties ended up being about 1/3 of our starting strength. We had enormous difficulty getting resupply of ammunition and water (the only two combat supplies that mattered) to the troops, and evacuating casualties out of the building. When we finally declared the building clear, my company was spent\\\\u2014down 1/3 of it strength and utterly exhausted.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"And that was taking a single, two-story building.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Now, yes, as the exercise went on, we got better at it (which was the point). But I still found that my company couldn\\\\u2019t take more than two or three two-story, elementary school-sized buildings before it was spent, and we had to reconstitute and rest. And remember that all of my \\\\u201cdead\\\\u201d soldiers immediately came back to life, so it was as though I had a constant stream of trained soldiers to bring me back up to 100% strength every day. That\\\\u2019s not really going to happen.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"But wait, it gets better. Cities are complex things, with many covered approaches to buildings. So, once you take a building, you have to garrison it, to make sure the bad guys don\\\\u2019t just move back in\\\\u2014at least until you\\\\u2019ve taken enough of the buildings around it that\\\\u2019s no longer a significant risk. Still, it ties up more troops\\\\u2026\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\\u2026which brings me to the crux of this. On average, over the course of the week-long exercise, we discovered that an infantry company can realistically take and hold maybe a half-dozen buildings (fewer, if they\\\\u2019re larger and multi-story buildings). There are 3 or 4 companies to a battalion, 2 or 3 infantry battalions to a brigade, 3 brigades to a division and 3 divisions to a corps (normally\\\\u2026the numbers can vary). So if we multiply that out, a corps contains about 108 infantry companies. That means a corps can take about, say, 700 buildings with its available combat power. Let\\\\u2019s factor in the effects of fire support (which is hugely limited in a city\\\\u2014things like tanks and artillery are FAR less effective in urban areas), assume there a no civilians or cultural sites to watch out for, assume we\\\\u2019ve got the enemy heavily outnumbered and the city isolated. Based on all that, let\\\\u2019s be generous and assume a corps can, ultimately, take 5 times that number of buildings, or about 3,500, before it is spent and incapable of further offensive operations.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Now, yes, that corps will recover\\\\u2014it will reorganize, rest, receive replacements and supplies, and so on. So, over time, it will be able to take another 3,500 buildings. And another 3,500. And another. And so on. But the price in blood and material is enormous...\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|2060712532\",\"viewerHasAccess\":false,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-363535325_a581eef886283b05009a16c7c9902cbd\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":120342082,\"id\":\"UXVlc3Rpb25AMDoxMjAzNDIwODI=\",\"isDeleted\":false,\"url\":\"/How-can-you-determine-if-a-city-is-strategic-or-a-key-factor-in-determining-a-war-Such-as-playing-games-like-Civilization-or-in-a-time-of-war-why-not-just-take-control-of-every-city-or-go-around-these-cities-if\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How can you determine if a city is strategic or a key factor in determining a war? Such as playing games like Civilization or in a time of war, why not just take control of every city or go around these cities if defenders are inside?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjMxNDQwNDAyNQ==\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":314404025},\"slug\":\"How-can-you-determine-if-a-city-is-strategic-or-a-key-factor-in-determining-a-war-Such-as-playing-games-like-Civilization-or-in-a-time-of-war-why-not-just-take-control-of-every-city-or-go-around-these-cities-if\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":7,\"suggestedReplies\":[]},\"permaUrl\":\"/How-can-you-determine-if-a-city-is-strategic-or-a-key-factor-in-determining-a-war-Such-as-playing-games-like-Civilization-or-in-a-time-of-war-why-not-just-take-control-of-every-city-or-go-around-these-cities-if/answer/David-Laderoute\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/How-can-you-determine-if-a-city-is-strategic-or-a-key-factor-in-determining-a-war-Such-as-playing-games-like-Civilization-or-in-a-time-of-war-why-not-just-take-control-of-every-city-or-go-around-these-cities-if/answer/David-Laderoute\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":363535325,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticContent\":{\"title\":\"There is help\",\"contentQtextDocument\":{\"legacyJson\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Need Help? Contact a suicide hotline if you need someone to talk to. If you have a friend in need of help, please encourage that person to contact a suicide hotline as well.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Worldwide\\\\nIn general, if you're outside the US, numbers for your country are here: \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Help a friend - Befrienders Worldwide\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://www.befrienders.org/support/helplines.asp\\\"}}}, {\\\"text\\\": \\\". You can also e-mail \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"jo@samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"mailto:jo@samaritans.org\\\"}}}, {\\\"text\\\": \\\" to talk to someone or visit \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"samaritans.org\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.samaritans.org/how-we-can-help-you/contact-us\\\"}}}, {\\\"text\\\": \\\" to speak with someone.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"United States\\\\nCall the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"National Suicide Prevention Lifeline\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://suicidepreventionlifeline.org/\\\"}}}, {\\\"text\\\": \\\" at 1-800-273-TALK (8255).\\\\nPara espa\\u00f1ol, llame al \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"1-888-628-9454\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"#\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"unordered-list\\\", \\\"is_rtl\\\": false}]}\",\"id\":\"UXRleHREb2N1bWVudEAwOjkzYzA5ZjNjYjc4MmRkNGEzMWFiMTRmNjhiMWU2YzIz\"},\"staticContentType\":\"suicide_prevention_message\",\"internalUrl\":\"\",\"id\":\"U3RhdGljQ29udGVudEAwOnN1aWNpZGVfcHJldmVudGlvbl9tZXNzYWdl\"}},\"author\":{\"id\":\"VXNlckAwOjcxNjg4Njgy\",\"uid\":71688682,\"__typename\":\"User\",\"useTranslatedName\":false,\"isMachineAnswerBot\":false,\"names\":[{\"__typename\":\"UserName\",\"id\":\"VXNlck5hbWU6NzE2ODg2ODI6TEFUTg==\",\"reverseOrder\":false,\"givenName\":\"David\",\"familyName\":\"Laderoute\",\"scriptCode\":\"LATN\"}],\"adminNames\":[],\"isAnon\":false,\"profileUrl\":\"/profile/David-Laderoute\",\"smallProfileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"profileImageUrl\":\"https://qsf.cf2.quoracdn.net/-4-images.new_grid.profile_default.png-26-688c79556f251aa0.png\",\"isVerified\":false,\"businessStatus\":null,\"consumerBundleActive\":false,\"producerBundleStatus\":\"enabled\",\"viewerHasMuted\":false},\"__isContentObject\":\"Answer\",\"isSensitive\":true,\"creationTime\":1655855243661000,\"hasSuicideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TGlmZUV4cGVyaWVuY2VDcmVkZW50aWFsQDA6MzM4OTgzMDM=\",\"__typename\":\"LifeExperienceCredential\",\"__isCredential\":\"LifeExperienceCredential\",\"translatedString\":\"Retired Lieutenant Colonel, Canadian Army (Infantry)\",\"experience\":{\"id\":\"VG9waWNAMDo2Mjk2\",\"__typename\":\"Topic\",\"tid\":6296,\"name\":\"Military\"},\"description\":\"Retired Lieutenant Colonel, Canadian Army (Infantry)\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":33898303},\"isTranslated\":false,\"url\":\"/How-can-you-determine-if-a-city-is-strategic-or-a-key-factor-in-determining-a-war-Such-as-playing-games-like-Civilization-or-in-a-time-of-war-why-not-just-take-control-of-every-city-or-go-around-these-cities-if/answer/David-Laderoute\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDozNjM1MzUzMjU6WzE0MTYsIDIwMjYyMDBd\",\"viewCount\":2026200,\"answerCount\":1416}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"smart_distribution\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":295,\"__isVotable\":\"Answer\",\"numUpvotes\":2,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":363535325,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"14\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjE1\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MjU2NDQ2NjI5\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":11,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":83659006,\"id\":\"UXVlc3Rpb25AMDo4MzY1OTAwNg==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MjU2NDQ2NjI5\",\"aid\":256446629,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"It happened all the time.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In Britain, when \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Boudica\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Boudica\\\"}}}, {\\\"text\\\": \\\" rebelled and burned down London, St. Albans and Colchester, Imperial Rome rebuilt them and quickly.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Colchester\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#Roman_period\\\"}}}, {\\\"text\\\": \\\": \\\\u201cSometime after the destruction, London became the capital of the province of \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Britannia\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Britannia\\\"}}}, {\\\"text\\\": \\\".\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[24]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#cite_note-24\\\"}}}, {\\\"text\\\": \\\" Colchester's town walls c. 3,000 yd. long were built c.65\\\\u201380 A.D. when the Roman town was rebuilt after the Boudicca rebellion.\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[25]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#cite_note-25\\\"}}}, {\\\"text\\\": \\\" In 2004, Colchester Archaeological Trust discovered the remains of a Roman Circus (chariot race track) underneath the Garrison in Colchester, a unique find in Britain.\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[26]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#cite_note-26\\\"}}}, {\\\"text\\\": \\\" The Roman town of \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Camulodunum\\\", \\\"modifiers\\\": {\\\"italic\\\": true}}, {\\\"text\\\": \\\", officially known as \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Colonia Victricensis\\\", \\\"modifiers\\\": {\\\"italic\\\": true}}, {\\\"text\\\": \\\", reached its peak in the Second and Third centuries AD.\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[9]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#cite_note-Crummy,_Philip_1997-9\\\"}}}, {\\\"text\\\": \\\"[27]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#cite_note-Faulkner,_1994-27\\\"}}}, {\\\"text\\\": \\\" It may have reached a population of 30,000 in that period.\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[28]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Colchester#cite_note-google-28\\\"}}}, {\\\"text\\\": \\\"\\\\u201d\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Rebuilt:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\", \\\"modifiers\\\": {\\\"image\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-3544c2b881f4fcc8dc5582545aa215bc-lq\\\", \\\"height\\\": 990, \\\"width\\\": 1317, \\\"master_url\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-b7915414d98f1e7bf79ea7f855047d1d\\\", \\\"is_deleted\\\": false, \\\"is_sensitive\\\": false, \\\"is_uploaded_by_bot\\\": false, \\\"zoomable\\\": true, \\\"dominant_color\\\": \\\"#9aa45e\\\"}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"image\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"In a different part of the world:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Jericho\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Jericho\\\"}}}, {\\\"text\\\": \\\": \\\\u201c\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Archaeologists\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Archaeology\\\"}}}, {\\\"text\\\": \\\" have unearthed the remains of more than 20 successive settlements in Jericho, the first of which dates back 11,000 years (9000 BCE),\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[12]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Jericho#cite_note-12\\\"}}}, {\\\"text\\\": \\\"[13]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Jericho#cite_note-encyclopedia1-13\\\"}}}, {\\\"text\\\": \\\" almost to the very beginning of the \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"Holocene\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Holocene\\\"}}}, {\\\"text\\\": \\\" epoch of the Earth's history.\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"[14]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Jericho#cite_note-14\\\"}}}, {\\\"text\\\": \\\"[15]\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Jericho#cite_note-15\\\"}}}, {\\\"text\\\": \\\"\\\\u201d\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"Schematic Representation of Pre-Pottery Neolithic B Tower at Jericho\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"https://www.researchgate.net/figure/Schematic-Representation-of-Pre-Pottery-Neolithic-B-Tower-at-Jericho-redrawn-and_fig10_228562084\\\"}}}, {\\\"text\\\": \\\", redrawn and simplified from Kenyon (\\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"AfterMarket.pl :: domena 1981.Pl\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://1981.Pl\\\"}}}, {\\\"text\\\": \\\". 238), with projection of 14 C-ages by stratigraphic layer, as provided in Table 2. This diagram is used as the basis for applying a simple linear growth (equidistant 50-yr phase length) model to the stratified 14 C-ages, with wiggle matching results shown in Figure 12. In Layer X, the PPNA tower is covered by soft, grey powdery soil (Kenyon \\\", \\\"modifiers\\\": {}}, {\\\"text\\\": \\\"AfterMarket.pl :: domena 1981.Pl\\\", \\\"modifiers\\\": {\\\"link\\\": {\\\"type\\\": \\\"url\\\", \\\"url\\\": \\\"http://1981.Pl\\\"}}}, {\\\"text\\\": \\\". 238), which may have been deposited by mudflows (Bar-Yosef 1986) during the 10.2 ka calBP RCC:\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\", \\\"modifiers\\\": {\\\"image\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-cc113b57b61c7d24acfdedb58146a2d2-pjlq\\\", \\\"height\\\": 490, \\\"width\\\": 642, \\\"master_url\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-1a6840e50ea3f88fd26db310e3f0b768\\\", \\\"is_deleted\\\": false, \\\"is_sensitive\\\": false, \\\"is_uploaded_by_bot\\\": false, \\\"zoomable\\\": true, \\\"dominant_color\\\": \\\"#fdfdfd\\\"}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"image\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"\\\", \\\"modifiers\\\": {\\\"image\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-92bf79bc3eacdf91822e2a6d5a53ac71-lq\\\", \\\"height\\\": 546, \\\"width\\\": 728, \\\"master_url\\\": \\\"https://qph.cf2.quoracdn.net/main-qimg-8dd5ec41a197b311ea346c0a937e88fb\\\", \\\"is_deleted\\\": false, \\\"is_sensitive\\\": false, \\\"is_uploaded_by_bot\\\": false, \\\"zoomable\\\": true, \\\"dominant_color\\\": \\\"#fff1c8\\\"}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"image\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"I define archaeological field work as exploring cultural layers, precisely because of rebuilding.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|1538807390\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-256446629_c983fc73a40d0b2bd17dedb6b17b9fbd\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":83659006,\"id\":\"UXVlc3Rpb25AMDo4MzY1OTAwNg==\",\"isDeleted\":false,\"url\":\"/How-long-does-it-take-for-a-sacked-or-looted-city-to-recover-in-history-Can-a-completely-razed-city-be-rebuilt\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How long does it take for a sacked or looted city to recover in history? Can a completely razed city be rebuilt?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjkwMjI2OTU1\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":90226955},\"slug\":\"How-long-does-it-take-for-a-sacked-or-looted-city-to-recover-in-history-Can-a-completely-razed-city-be-rebuilt\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":2,\"suggestedReplies\":[\"What are some modern examples of cities recovering