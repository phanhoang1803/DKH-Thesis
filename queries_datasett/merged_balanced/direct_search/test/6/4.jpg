lse,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":1,\"__isReportable\":\"Answer\",\"reportableId\":256446951,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"22\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjIz\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MzUyOTk0NDE1\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":19,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":116500591,\"id\":\"UXVlc3Rpb25AMDoxMTY1MDA1OTE=\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MzUyOTk0NDE1\",\"aid\":352994415,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"If everyone was in giant cities, war planning would be greatly simplified, and war materiel much cheaper. Instead of nukes you could find ways to disrupt the city water or power supply, to block food deliveries from the surrounding agricultural region, to harass or kill the resistance \\\\u2026\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"If you don\\\\u2019t have to spread your power all across the landscape, war is simplified.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-962675647\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-352994415_b58a5f500aba0671c8cd6fd46d841378\",\"isSelectedForDigestClickthroughSurvey\":false,\"question\":{\"qid\":116500591,\"id\":\"UXVlc3Rpb25AMDoxMTY1MDA1OTE=\",\"isDeleted\":false,\"url\":\"/How-would-warfare-change-if-everyone-was-concentrated-into-giant-cities\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"How would warfare change if everyone was concentrated into giant cities?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"__typename\":\"Question\",\"isPartnerQuestion\":false,\"isTrendyQuestion\":false,\"isFollowUpQuestion\":false,\"asker\":{\"id\":\"VXNlckAwOjY1MDQ2NTk5\",\"__typename\":\"User\",\"isEmployee\":false,\"uid\":65046599},\"slug\":\"How-would-warfare-change-if-everyone-was-concentrated-into-giant-cities\",\"network\":{\"nid\":0,\"id\":\"TmV0d29yazow\"},\"tribeItem\":null,\"answerCount\":2,\"suggestedReplies\":[]},\"permaUrl\":\"/How-would-warfare-change-if-everyone-was-concentrated-into-giant-cities/answer/Ronald-Carpenter-27\",\"isVisibleToViewer\":true,\"viewerIsAuthor\":false,\"isShortContent\":false,\"permaUrlOnOriginalQuestion\":\"/How-would-warfare-change-if-everyone-was-concentrated-into-giant-cities/answer/Ronald-Carpenter-27\",\"viewerCanRestoreAnswer\":false,\"__isMonetizable\":\"Answer\",\"oid\":352994415,\"contentType\":\"answer\",\"tribe\":null,\"viewer\":{\"consumerBundleSubscription\":null,\"id\":\"Vmlld2VyQDA6MA==\",\"tribeDirectSubscriptions\":[],\"user\":null,\"staticConten