ideTopics\":false,\"updatedTime\":0,\"authorTribeUser\":null,\"__isCredentialContainer\":\"Answer\",\"authorCredential\":{\"id\":\"TGlmZUV4cGVyaWVuY2VDcmVkZW50aWFsQDA6MjE5NjE5Mg==\",\"__typename\":\"LifeExperienceCredential\",\"__isCredential\":\"LifeExperienceCredential\",\"translatedString\":\"Read a lot about economics. I'd deny it is a science.\",\"experience\":{\"id\":\"VG9waWNAMDoxNTc1\",\"__typename\":\"Topic\",\"tid\":1575,\"name\":\"Economics\"},\"description\":\"Read a lot about economics. I'd deny it is a science.\",\"isDefault\":false,\"isBad\":false,\"isEnqueued\":false,\"credentialId\":2196192},\"isTranslated\":false,\"url\":\"/How-long-does-it-take-for-a-country-to-recover-and-grow-its-economy-after-a-war/answer/Gwydion-Madawc-Williams\",\"isOwnTranslation\":false,\"businessCredential\":null,\"businessAnswer\":null,\"credibilityFacts\":[{\"__typename\":\"AuthorInfoFact\",\"id\":\"QXV0aG9ySW5mb0ZhY3RAMDo2OTIyNjMzOls0NzY5NiwgNDQ1MTI2NjBd\",\"viewCount\":44512660,\"answerCount\":47696}],\"sourceNetwork\":null,\"sourceQuestion\":null,\"sourceAnswer\":null,\"effectiveAccessOption\":\"free\",\"monetizationIneligibilityReasons\":[],\"notForReproduction\":false,\"numViews\":2482,\"__isVotable\":\"Answer\",\"numUpvotes\":6,\"__isQuoraShareable\":\"Answer\",\"numShares\":0,\"moderationCollapseType\":null,\"numRequesters\":0,\"requesters\":[],\"isCommentsDisabled\":false,\"isCollapsedForViewer\":false,\"isModerationLocked\":false,\"moderationCollapseTypeUrl\":null,\"network\":{\"id\":\"TmV0d29yazow\",\"__typename\":\"Network\",\"contentLanguageCode\":\"en\",\"appealsFormUrl\":\"https://help.quora.com/hc/en/requests/new?ticket_form_id=198746\"},\"collapseOperation\":null,\"numDisplayComments\":0,\"__isReportable\":\"Answer\",\"reportableId\":6922633,\"canViewerReport\":false,\"viewerVoteType\":\"novote\"}},\"cursor\":\"24\"},{\"id\":\"UXVlc3Rpb25QYWdlZExpc3RFZGdlOjI1\",\"__typename\":\"QuestionPagedListEdge\",\"node\":{\"id\":\"UXVlc3Rpb25SZWxldmFudEFuc3dlckl0ZW0yQDA6MzUwNzgwOTphbnN3ZXI6MTcxOTIyMjM1\",\"__typename\":\"QuestionRelevantAnswerItem2\",\"__isQuestionPagedListItem\":\"QuestionRelevantAnswerItem2\",\"question\":{\"qid\":3507809,\"id\":\"UXVlc3Rpb25AMDozNTA3ODA5\",\"title\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"When war affects a modern city, how long does it take after fighting ends before city life gets back to normal -- businesses operating at prewar levels, population growth, etc.?\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"isQuestionDecanonActive\":true,\"areRelatedAnswersEnabled\":true},\"index\":21,\"isEquivalentAnswer\":false,\"relatedQuestion\":{\"qid\":58005085,\"id\":\"UXVlc3Rpb25AMDo1ODAwNTA4NQ==\"},\"answer\":{\"originalQuestionIfDifferent\":null,\"id\":\"QW5zd2VyQDA6MTcxOTIyMjM1\",\"aid\":171922235,\"isDeleted\":false,\"isMachineAnswer\":false,\"content\":\"{\\\"sections\\\": [{\\\"spans\\\": [{\\\"text\\\": \\\"Ideally in such case things continue with minimal interference. People pay their food with money just as before. Of course in modern world where electronic payments are more common there may be problems. The occupying authority of course may impose restrictions like curfews.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}, {\\\"spans\\\": [{\\\"text\\\": \\\"The hardest thing is with authorities like police. They necessarily need to co-operate with the occupying power in order to keep public order. However, they cannot co-operate further than necessary for that or they could commit treason.\\\", \\\"modifiers\\\": {}}], \\\"indent\\\": 0, \\\"quoted\\\": false, \\\"type\\\": \\\"plain\\\", \\\"is_rtl\\\": false}]}\",\"questionPageImpressionHash\":\"answer_ranking|-947572021\",\"viewerHasAccess\":true,\"feedbackSurveyVariant\":0,\"tribeItem\":null,\"__typename\":\"Answer\",\"viewHash\":\"a-171922235_977e31e8dd3e76d